      <rect x="24" y="201" width="24" height="24" rx="3" fill="#dadce0"/>
      <rect x="64" y="185" width="200" height="10" rx="5" fill="#444746"/>
      <rect x="64" y="207" width="380" height="8" rx="4" fill="#9aa0a6"/>
      <rect x="64" y="223" width="300" height="8" rx="4" fill="#9aa0a6"/>
      <rect x="530" y="209" width="44" height="8" rx="4" fill="#9aa0a6"/>
      <!-- Row 5 · dense 40px -->
      <rect x="1" y="257" width="598" height="40" fill="#ffffff" stroke="#dadce0"/>
      <rect x="24" y="265" width="24" height="24" rx="3" fill="#dadce0"/>
      <rect x="64" y="273" width="140" height="8" rx="4" fill="#444746"/>
      <rect x="530" y="273" width="40" height="8" rx="4" fill="#9aa0a6"/>
