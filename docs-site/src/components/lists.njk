<section class="docs-section">
  <h2 id="i-theming">Theming</h2>
  <p>Everything is a CSS custom property on <code>:root</code> — override inline
     or in your own stylesheet, no rebuild:</p>
  <table class="docs-table">
    <thead>
      <tr><th>Token</th><th>Affects</th></tr>
    </thead>
    <tbody>
      <tr><td><code>--fl-tint</code></td><td>Selected row fill</td></tr>
      <tr><td><code>--fl-hover</code></td><td>Row hover fill</td></tr>
      <tr><td><code>--fl-divider</code></td><td>Opt-in divider color</td></tr>
      <tr><td><code>--fl-icon-ph</code></td><td>Avatar placeholder fill</td></tr>
      <tr><td><code>--fl-text-secondary</code></td><td>Sub text, meta text</td></tr>
      <tr><td><code>--fl-fs-caption</code></td><td>Sub/meta font size</td></tr>
    </tbody>
  </table>
  {% set themeExample %}
:root {
  --fl-tint: #e6f4ea;   /* rows tint green when selected */
}
{% endset %}
  {{ snippet(themeExample) }}
</section>
{% endset %}

