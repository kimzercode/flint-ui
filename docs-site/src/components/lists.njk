      <rect x="24" y="60" width="24" height="24" rx="3" fill="#5f6368"/>
      <rect x="64" y="69" width="150" height="8" rx="4" fill="#444746"/>
      <rect x="516" y="65" width="22" height="16" rx="8" fill="#1a73e8"/>
      <!-- Row 3 · two-line 72px: 40px avatar, title + sub, trailing action -->
      <rect x="1" y="97" width="598" height="72" fill="#ffffff" stroke="#dadce0"/>
      <circle cx="44" cy="133" r="20" fill="#dadce0"/>
      <rect x="34" y="129" width="20" height="8" rx="4" fill="#9aa0a6"/>
      <rect x="80" y="112" width="180" height="10" rx="5" fill="#444746"/>
