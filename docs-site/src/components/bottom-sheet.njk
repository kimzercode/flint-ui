<section class="docs-section">
  <h2 id="i-theming">Theming</h2>
  <p>Everything is a CSS custom property on <code>:root</code> — override
     inline or in your own stylesheet, no rebuild:</p>
  <table class="docs-table">
    <thead>
      <tr><th>Token</th><th>Affects</th></tr>
    </thead>
    <tbody>
      <tr><td><code>--fl-scrim</code></td><td>The backdrop, shared with the dialog and drawer</td></tr>
      <tr><td><code>--fl-surface</code></td><td>The sheet fill</td></tr>
      <tr><td><code>--fl-border</code></td><td>The 1px border</td></tr>
      <tr><td><code>--fl-radius-lg</code></td><td>The top corner radius (8px)</td></tr>
      <tr><td><code>--fl-sheet-max-h</code></td><td>The initial height cap (50dvh)</td></tr>
      <tr><td><code>--fl-option-h</code></td><td>Row height (56px inside sheets, 48px dialogs)</td></tr>
      <tr><td><code>--fl-z-sheet</code></td><td>Standard sheet layer (below the snackbar)</td></tr>
      <tr><td><code>--fl-dur</code> / <code>--fl-ease</code></td><td>Open/close animation timing</td></tr>
    </tbody>
  </table>
  {% set themeExample %}
:root {
  --fl-radius-lg: 16px;           /* rounder sheet top corners */
  --fl-scrim: rgb(0 0 0 / 0.4);   /* darker scrim, every scrim follows */
  --fl-sheet-max-h: 60dvh;        /* taller initial cap */
}
{% endset %}
  {{ snippet(themeExample) }}
</section>
{% endset %}

