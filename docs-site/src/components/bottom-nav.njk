<section class="docs-section">
  <h2 id="i-theming">Theming</h2>
  <p>Everything is a CSS custom property on <code>:root</code> — override inline
     or in your own stylesheet, no rebuild:</p>
  <table class="docs-table">
    <thead>
      <tr><th>Token</th><th>Affects</th></tr>
    </thead>
    <tbody>
      <tr><td><code>--fl-accent</code></td><td>Selected tab icon/label tint, pill text</td></tr>
      <tr><td><code>--fl-tint</code></td><td>Desktop selected-tab pill fill</td></tr>
      <tr><td><code>--fl-hover</code></td><td>Tab hover fill (mobile)</td></tr>
      <tr><td><code>--fl-border</code></td><td>Bar top border, FAB border</td></tr>
      <tr><td><code>--fl-topbar-h</code></td><td>Top bar height</td></tr>
      <tr><td><code>--fl-content-max</code></td><td>Max content column width on desktop</td></tr>
      <tr><td><code>--fl-tabbar-h</code></td><td>Tab bar height (56px at every breakpoint)</td></tr>
    </tbody>
  </table>
  {% set themeExample %}
:root {
  --fl-accent: #188038;    /* green Google */
  --fl-tint: #e6f4ea;
}
{% endset %}
  {{ snippet(themeExample) }}
</section>
{% endset %}

