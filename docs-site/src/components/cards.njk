<section class="docs-section">
  <h2 id="i-theming">Theming</h2>
  <p>Everything is a CSS custom property on <code>:root</code> — override inline
     or in your own stylesheet, no rebuild:</p>
  <table class="docs-table">
    <thead>
      <tr><th>Token</th><th>Affects</th></tr>
    </thead>
    <tbody>
      <tr><td><code>--fl-border</code></td><td>The card's 1px separation</td></tr>
      <tr><td><code>--fl-radius-card</code></td><td>Corner radius (8px)</td></tr>
      <tr><td><code>--fl-fs-title</code> / <code>--fl-fs-body</code></td><td>Title / text sizes</td></tr>
      <tr><td><code>--fl-text-secondary</code></td><td>Body text color</td></tr>
      <tr><td><code>--fl-space-3</code></td><td>Card padding and stack gap</td></tr>
    </tbody>
  </table>
  {% set themeExample %}
:root {
  --fl-radius-card: 12px;   /* soften the corners */
}
{% endset %}
  {{ snippet(themeExample) }}
</section>
