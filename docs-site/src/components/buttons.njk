<section class="docs-section">
  <h2 id="i-theming">Theming</h2>
  <p>Everything is a CSS custom property on <code>:root</code> — override inline
     or in your own stylesheet, no rebuild:</p>
  <table class="docs-table">
    <thead>
      <tr><th>Token</th><th>Affects</th></tr>
    </thead>
    <tbody>
      <tr><td><code>--fl-accent</code></td><td>Filled fill; outline/text label color</td></tr>
      <tr><td><code>--fl-accent-hover</code></td><td>Filled hover fill</td></tr>
      <tr><td><code>--fl-accent-pressed</code></td><td>Filled active fill</td></tr>
      <tr><td><code>--fl-hover</code></td><td>Outline/text hover fill</td></tr>
      <tr><td><code>--fl-border</code></td><td>Outline variant border</td></tr>
      <tr><td><code>--fl-radius</code></td><td>Corner radius (4px)</td></tr>
      <tr><td><code>--fl-fs-body</code></td><td>Label size (14px)</td></tr>
    </tbody>
  </table>
  {% set themeExample %}
:root {
  --fl-accent: #188038;          /* green Google */
  --fl-accent-hover: #166b30;
  --fl-accent-pressed: #135626;
}
{% endset %}
  {{ snippet(themeExample) }}
</section>
{% endset %}

