<section class="docs-section">
  <h2 id="i-code">Code</h2>
  {% set quickStart %}
<link rel="stylesheet" href="css/flint.css">
<script src="js/flint.js" defer></script>
{% endset %}
  {{ snippet(quickStart) }}
  <p>Modal side sheet — the M2 filter panel: checkbox rows as
     <code>&lt;label class="fl-option"&gt;</code>, fields in
     <code>__group</code> wrappers:</p>
  {% set modalMarkup %}
<button class="fl-btn" data-fl-open="ss-filters">Filter files</button>

<dialog class="fl-sidesheet" id="ss-filters" aria-label="Filters">
  <div class="fl-sidesheet__surface">
    <header class="fl-sidesheet__header">
      <h2 class="fl-sidesheet__title">Filters</h2>
      <button class="fl-icon-btn" type="button" data-fl-close
              aria-label="Close filters">…</button>
    </header>
    <div class="fl-sidesheet__body">
      <p class="fl-sidesheet__group fl-section-label">Labels</p>
      <ul class="fl-sidesheet__list">
        <li><label class="fl-option">
          <input type="checkbox" class="fl-check"> Events
        </label></li>
        <li><label class="fl-option">
          <input type="checkbox" class="fl-check" checked> Personal
        </label></li>
      </ul>
      <div class="fl-sidesheet__group">
        <p class="fl-section-label">Format</p>
        <div class="fl-field fl-select">
          <label class="fl-field__label" id="f-format-label" for="f-format">File format</label>
          <div class="fl-field__box">
            <input type="hidden" name="format" value="all">
            <button class="fl-select__anchor" type="button" role="combobox" id="f-format"
                    popovertarget="f-format-menu" aria-controls="f-format-menu" aria-haspopup="listbox" aria-expanded="false"
                    aria-labelledby="f-format-label">
              <span class="fl-select__value" id="f-format-value">All</span>
            </button>
          </div>
          <div class="fl-menu fl-menu--fullwidth" id="f-format-menu" popover role="listbox"
               aria-labelledby="f-format-label">
            <button class="fl-option" role="option" type="button" aria-selected="true">All</button>
            <button class="fl-option" role="option" type="button" aria-selected="false">Documents</button>
            <button class="fl-option" role="option" type="button" aria-selected="false">Spreadsheets</button>
            <button class="fl-option" role="option" type="button" aria-selected="false">Images</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</dialog>
{% endset %}
  {{ snippet(modalMarkup) }}
  <p>Standard side sheet — persistent, non-modal, zero library JS. Visibility
     is author logic (toggle <code>hidden</code>); the page clears the panel
     with <code>padding-right</code>:</p>
  {% set standardMarkup %}
<aside class="fl-sidesheet fl-sidesheet--standard" id="ss-details" hidden>
  <div class="fl-sidesheet__surface">
    <header class="fl-sidesheet__header">
      <h2 class="fl-sidesheet__title">Details</h2>
      <button class="fl-icon-btn" type="button" aria-label="Close details">…</button>
    </header>
    <div class="fl-sidesheet__body">
      <div class="fl-sidesheet__group">
        <div class="fl-field">
          <div class="fl-field__box">
            <input class="fl-field__input" aria-label="Add a description"
                   placeholder="Add a description">
          </div>
        </div>
      </div>
      <ul class="fl-list">
        <li class="fl-list-item">…icon + metadata rows…</li>
      </ul>
    </div>
  </div>
</aside>

<!-- the page clears the sheet while it's open -->
<main style="padding-right: var(--fl-sidesheet-w)">…</main>
{% endset %}
  {{ snippet(standardMarkup) }}
</section>

