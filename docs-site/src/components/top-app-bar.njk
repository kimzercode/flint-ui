<section class="docs-section">
  <h2 id="i-theming">Theming</h2>
  <p>The bar consumes the shared tokens — no top-bar-specific custom
     properties (internal <code>--_</code> values are not theming API):</p>
  <table class="docs-table">
    <thead>
      <tr><th>Token</th><th>Affects</th></tr>
    </thead>
    <tbody>
      <tr><td><code>--fl-topbar-h</code></td><td>Bar height (64px, 56px under 600px)</td></tr>
      <tr><td><code>--fl-surface</code> / <code>--fl-border</code></td><td>Bar fill and 1px bottom border (muted by the transparent variant)</td></tr>
      <tr><td><code>--fl-field-h</code></td><td>Search pill height (scoped to 48px inside <code>fl-top-bar__search</code>)</td></tr>
      <tr><td><code>--fl-text</code> / <code>--fl-surface</code></td><td>Contextual bar: inverse fill and its text color</td></tr>
      <tr><td><code>--fl-fs-title</code></td><td>Title size/weight</td></tr>
      <tr><td><code>--fl-dur</code> / <code>--fl-ease</code></td><td>Scroll-hide slide timing</td></tr>
    </tbody>
  </table>
  {% set themeExample %}
:root {
  --fl-topbar-h: 72px;   /* roomier bar */
}
{% endset %}
  {{ snippet(themeExample) }}
</section>
{% endset %}

