        <g><circle cx="28" cy="45" r="11" fill="#1a73e8"/><text x="28" y="49" fill="#ffffff" text-anchor="middle">1</text></g>
        <g><circle cx="28" cy="97" r="11" fill="#1a73e8"/><text x="28" y="101" fill="#ffffff" text-anchor="middle">2</text></g>
