<section class="docs-section">
  <h2 id="i-theming">Theming</h2>
  <p>Everything is a CSS custom property on <code>:root</code> — override inline
     or in your own stylesheet, no rebuild:</p>
  <table class="docs-table">
    <thead>
      <tr><th>Token</th><th>Affects</th></tr>
    </thead>
    <tbody>
      <tr><td><code>--fl-accent</code></td><td>Checked fill, radio ring/dot, switch-on thumb</td></tr>
      <tr><td><code>--fl-tint</code></td><td>Switch-on track</td></tr>
      <tr><td><code>--fl-text-secondary</code></td><td>Unchecked border</td></tr>
      <tr><td><code>--fl-disabled</code></td><td>Disabled glyphs and the switch-off track</td></tr>
      <tr><td><code>--fl-divider</code></td><td>Disabled borders</td></tr>
      <tr><td><code>--fl-dur</code> / <code>--fl-ease</code></td><td>Switch slide and fill transitions</td></tr>
    </tbody>
  </table>
  {% set themeExample %}
:root {
  --fl-accent: #188038;   /* check, radio dot and switch thumb follow */
  --fl-tint: #e6f4ea;     /* switch-on track follows */
}
{% endset %}
  {{ snippet(themeExample) }}
</section>
{% endset %}

