<section class="docs-section">
  <h2 id="i-theming">Theming</h2>
  <p>Everything is a CSS custom property on <code>:root</code> — override
     inline or in your own stylesheet, no rebuild:</p>
  <table class="docs-table">
    <thead>
      <tr><th>Token</th><th>Affects</th></tr>
    </thead>
    <tbody>
      <tr><td><code>--fl-scrim</code></td><td>The backdrop, shared with the bottom sheet and drawer</td></tr>
      <tr><td><code>--fl-surface</code></td><td>The card fill</td></tr>
      <tr><td><code>--fl-border</code></td><td>The 1px card border</td></tr>
      <tr><td><code>--fl-radius-card</code></td><td>Corner radius (8px)</td></tr>
      <tr><td><code>--fl-error</code></td><td>The danger action</td></tr>
      <tr><td><code>--fl-dur</code> / <code>--fl-ease</code></td><td>Open/close animation timing</td></tr>
    </tbody>
  </table>
  {% set themeExample %}
:root {
  --fl-scrim: rgb(0 0 0 / 0.4);   /* darker scrim, every overlay follows */
  --fl-radius-card: 4px;          /* squarer dialogs */
}
{% endset %}
  {{ snippet(themeExample) }}
</section>
{% endset %}

