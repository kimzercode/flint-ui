<section class="docs-section">
  <h2 id="i-theming">Theming</h2>
  <p>Everything is a CSS custom property on <code>:root</code> — override inline
     or in your own stylesheet, no rebuild:</p>
  <table class="docs-table">
    <thead>
      <tr><th>Token</th><th>Affects</th></tr>
    </thead>
    <tbody>
      <tr><td><code>--fl-tint</code></td><td>Selected nav row pill fill</td></tr>
      <tr><td><code>--fl-accent</code></td><td>Selected row icon/text tint, focus ring</td></tr>
      <tr><td><code>--fl-hover</code></td><td>Row hover fill</td></tr>
      <tr><td><code>--fl-border</code></td><td>Drawer column divider (replaces shadows)</td></tr>
      <tr><td><code>--fl-topbar-h</code></td><td>Top bar height</td></tr>
      <tr><td><code>--fl-content-max</code></td><td>Max content column width on desktop</td></tr>
      <tr><td><code>--fl-dur</code> / <code>--fl-ease</code></td><td>Drawer slide-in motion</td></tr>
    </tbody>
  </table>
  {% set themeExample %}
:root {
  --fl-accent: #188038;    /* green Google */
  --fl-tint: #e6f4ea;
}
{% endset %}
  {{ snippet(themeExample) }}
</section>
{% endset %}

