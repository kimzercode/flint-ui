      <rect x="110" y="80" width="120" height="8" rx="4" fill="#9aa0a6"/>
      <rect x="110" y="104" width="240" height="64" rx="8" fill="#ffffff" stroke="#dadce0"/>
      <rect x="126" y="120" width="150" height="10" rx="5" fill="#444746"/>
