      <g font-family="system-ui, sans-serif" font-size="12" font-weight="700">
        <g><circle cx="96" cy="25" r="11" fill="#1a73e8"/><text x="96" y="29" fill="#ffffff" text-anchor="middle">1</text></g>
        <g><circle cx="41" cy="60" r="11" fill="#1a73e8"/><text x="41" y="64" fill="#ffffff" text-anchor="middle">2</text></g>
        <g><circle cx="41" cy="87" r="11" fill="#1a73e8"/><text x="41" y="91" fill="#ffffff" text-anchor="middle">3</text></g>
