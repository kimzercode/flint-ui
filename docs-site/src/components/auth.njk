     or in your own stylesheet, no rebuild:</p>
  <table class="docs-table">
    <thead>
      <tr><th>Token</th><th>Affects</th></tr>
    </thead>
    <tbody>
      <tr><td><code>--fl-accent</code></td><td>Focus border on inputs, filled button, links</td></tr>
      <tr><td><code>--fl-border</code></td><td>Card border, input borders</td></tr>
      <tr><td><code>--fl-radius</code></td><td>Input corner radius</td></tr>
      <tr><td><code>--fl-radius-card</code></td><td>Card corner radius</td></tr>
      <tr><td><code>--fl-font</code></td><td>Everything text</td></tr>
    </tbody>
  </table>
  {% set themeExample %}
:root {
  --fl-accent: #188038;
}
{% endset %}
  {{ snippet(themeExample) }}
</section>
