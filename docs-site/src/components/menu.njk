<section class="docs-section">
  <h2 id="i-theming">Theming</h2>
  <p>The panel consumes the shared tokens — no menu-specific custom
     properties (internal <code>--_</code> values are not theming API):</p>
  <table class="docs-table">
    <thead>
      <tr><th>Token</th><th>Affects</th></tr>
    </thead>
    <tbody>
      <tr><td><code>--fl-surface</code></td><td>The panel fill</td></tr>
      <tr><td><code>--fl-border</code></td><td>The 1px panel border and group dividers</td></tr>
      <tr><td><code>--fl-radius</code></td><td>Corner radius (4px)</td></tr>
      <tr><td><code>--fl-text</code> / <code>--fl-text-secondary</code></td><td>Row labels and the meta column</td></tr>
      <tr><td><code>--fl-hover</code> / <code>--fl-divider</code></td><td>Row hover and pressed fills (shared with all state layers)</td></tr>
      <tr><td><code>--fl-dur</code> / <code>--fl-ease</code></td><td>Open/close fade timing</td></tr>
    </tbody>
  </table>
  {% set themeExample %}
:root {
  --fl-radius: 8px;   /* rounder menus */
}
{% endset %}
  {{ snippet(themeExample) }}
</section>
{% endset %}

