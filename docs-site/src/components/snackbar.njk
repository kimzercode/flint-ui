<section class="docs-section">
  <h2 id="i-theming">Theming</h2>
  <p>Everything is a CSS custom property on <code>:root</code> — override
     inline or in your own stylesheet, no rebuild:</p>
  <table class="docs-table">
    <thead>
      <tr><th>Token</th><th>Affects</th></tr>
    </thead>
    <tbody>
      <tr><td><code>--fl-text</code></td><td>The inverse container fill</td></tr>
      <tr><td><code>--fl-surface</code></td><td>The label color on the container</td></tr>
      <tr><td><code>--fl-accent-inverse</code></td><td>The action text (readable on dark)</td></tr>
      <tr><td><code>--fl-radius</code></td><td>Corner radius (4px)</td></tr>
      <tr><td><code>--fl-snackbar-inset</code></td><td>Side gutter for both horizontal edges, safe-area included; default 8px + inset. On phones it also decides the sheet's width</td></tr>
      <tr><td><code>--fl-snackbar-bottom</code></td><td>Distance to the bottom edge; defaults to the side gutter. Raise this one over a tab bar — the sides stay put. The FAB clearance is derived from <code>--fl-fab-size</code> and the FAB's inset — don't add the FAB height yourself</td></tr>
      <tr><td><code>--fl-z-snackbar</code></td><td>Layer order (above FABs, below modal surfaces)</td></tr>
      <tr><td><code>--fl-dur</code> / <code>--fl-ease</code></td><td>Show/hide animation timing</td></tr>
    </tbody>
  </table>
  {% set themeExample %}
:root {
  --fl-accent-inverse: #c9a6ff;   /* a purple action, still AA on --fl-text */
  --fl-radius: 0;                 /* square snackbars */
}
{% endset %}
  {{ snippet(themeExample) }}
</section>
{% endset %}

