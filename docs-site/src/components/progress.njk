<section class="docs-section">
  <h2 id="i-theming">Theming</h2>
  <p>Everything is a CSS custom property on <code>:root</code> — override
     inline or in your own stylesheet, no rebuild:</p>
  <table class="docs-table">
    <thead>
      <tr><th>Token</th><th>Affects</th></tr>
    </thead>
    <tbody>
      <tr><td><code>--fl-accent</code></td><td>The fill / arc</td></tr>
      <tr><td><code>--fl-tint</code></td><td>The track / ring background</td></tr>
      <tr><td><code>--fl-progress-value</code></td><td>The circle's determinate state (0–100, per element)</td></tr>
      <tr><td><code>--fl-progress-size</code></td><td>The circle's diameter (per element)</td></tr>
      <tr><td><code>--fl-dur</code> / <code>--fl-ease</code></td><td>Fill easing and loop timing</td></tr>
    </tbody>
  </table>
  {% set themeExample %}
:root {
  --fl-accent: #0b8043;   /* a green progress, Google-2020 green 600 */
  --fl-tint: #ceead6;     /* its matching track tint */
}
{% endset %}
  {{ snippet(themeExample) }}
</section>
{% endset %}

