<section class="docs-section">
  <h2 id="i-code">Code</h2>
  {% set quickStart %}
<link rel="stylesheet" href="css/flint.css">
{% endset %}
  {{ snippet(quickStart) }}
  <p>No script tag needed — this component is CSS only.</p>
  <p>Linear — determinate; the native attributes are the whole API:</p>
  {% set linearMarkup %}
<progress class="fl-progress" value="35" max="100"
          aria-label="Uploading files"></progress>
{% endset %}
  {{ snippet(linearMarkup) }}
  <p>Linear — indeterminate: drop the <code>value</code> attribute:</p>
  {% set linearInd %}
<progress class="fl-progress" aria-label="Loading feed"></progress>
{% endset %}
  {{ snippet(linearInd) }}
  <p>Circle — determinate: the value is one custom property:</p>
  {% set circleMarkup %}
<div class="fl-progress-circle" style="--fl-progress-value: 60" role="progressbar"
     aria-valuemin="0" aria-valuemax="100" aria-valuenow="60"
     aria-label="Backing up"></div>
{% endset %}
  {{ snippet(circleMarkup) }}
  <p>Circle — indeterminate: one class:</p>
  {% set circleInd %}
<div class="fl-progress-circle is-indeterminate" role="progressbar"
     aria-label="Connecting"></div>
{% endset %}
  {{ snippet(circleInd) }}
  <p>Moving it from your JS (linear and circle):</p>
  {% set jsMarkup %}
// linear: the native element is the state
bar.value = percent;

// circle: the property is the state — keep aria-valuenow in step
ring.style.setProperty("--fl-progress-value", percent);
ring.setAttribute("aria-valuenow", percent);
{% endset %}
  {{ snippet(jsMarkup) }}
</section>

