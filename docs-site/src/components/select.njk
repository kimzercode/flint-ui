<section class="docs-section">
  <h2 id="i-theming">Theming</h2>
  <p>Everything is a CSS custom property on <code>:root</code> — override inline
     or in your own stylesheet, no rebuild. The select reuses the field and
     menu tokens; only the chevron is new:</p>
  <table class="docs-table">
    <thead>
      <tr><th>Token</th><th>Affects</th></tr>
    </thead>
    <tbody>
      <tr><td><code>--fl-border</code></td><td>Field border; the open panel's border (filled fill is <code>--fl-divider</code>)</td></tr>
      <tr><td><code>--fl-accent</code></td><td>Focus/activated border and ring, the filled indicator</td></tr>
      <tr><td><code>--fl-error</code></td><td>Error border, ring, label and helper</td></tr>
      <tr><td><code>--fl-disabled</code></td><td>Disabled value text and disabled rows</td></tr>
      <tr><td><code>--fl-divider</code></td><td>Filled fill and the current row's tint</td></tr>
      <tr><td><code>--fl-hover</code></td><td>Row hover</td></tr>
      <tr><td><code>--fl-icon</code></td><td>Chevron fill</td></tr>
      <tr><td><code>--fl-select-chevron</code></td><td>The chevron glyph (a <code>url()</code> mask)</td></tr>
      <tr><td><code>--fl-radius</code></td><td>Field and panel corners</td></tr>
      <tr><td><code>--fl-option-h</code></td><td>Option row height (48px)</td></tr>
      <tr><td><code>--fl-surface</code></td><td>Panel background</td></tr>
    </tbody>
  </table>
  {% set themeExample %}
:root {
  --fl-select-chevron: url("data:image/svg+xml,...your chevron...");
  --fl-divider: #f1f3f4;   /* current row + filled fill follow */
}
{% endset %}
  {{ snippet(themeExample) }}
</section>
{% endset %}

