        <g><circle cx="420" cy="78" r="11" fill="#1a73e8"/><text x="420" y="82" fill="#ffffff" text-anchor="middle">2</text></g>
        <g><circle cx="28" cy="116" r="11" fill="#1a73e8"/><text x="28" y="120" fill="#ffffff" text-anchor="middle">3</text></g>
        <g><circle cx="28" cy="205" r="11" fill="#1a73e8"/><text x="28" y="209" fill="#ffffff" text-anchor="middle">4</text></g>
      </g>
      <!-- filled variant strip -->
      <rect x="40" y="150" width="360" height="44" rx="4" fill="#e8eaed"/>
      <rect x="40" y="192" width="360" height="2" fill="#1a73e8"/>
