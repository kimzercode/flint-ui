<section class="docs-section">
  <h2 id="i-theming">Theming</h2>
  <p>Everything is a CSS custom property on <code>:root</code> — override
     inline or in your own stylesheet, no rebuild:</p>
  <table class="docs-table">
    <thead>
      <tr><th>Token</th><th>Affects</th></tr>
    </thead>
    <tbody>
      <tr><td><code>--fl-field-h</code></td><td>Field height (44px; also the icon target width)</td></tr>
      <tr><td><code>--fl-border</code></td><td>Resting border</td></tr>
      <tr><td><code>--fl-text</code> / <code>--fl-text-secondary</code></td><td>Value + affix color / label + help + counter</td></tr>
      <tr><td><code>--fl-divider</code></td><td>Filled variant fill</td></tr>
      <tr><td><code>--fl-hover</code></td><td>Disabled fill, icon hover</td></tr>
      <tr><td><code>--fl-accent</code></td><td>Focus border + outline, filled focus indicator</td></tr>
      <tr><td><code>--fl-error</code></td><td>Error border/indicator, error text</td></tr>
      <tr><td><code>--fl-disabled</code></td><td>Disabled value, affixes, icons</td></tr>
      <tr><td><code>--fl-radius</code></td><td>Corner radius (4px)</td></tr>
      <tr><td><code>--fl-dur</code> / <code>--fl-ease</code></td><td>State transitions</td></tr>
    </tbody>
  </table>
  {% set themeExample %}
:root {
  --fl-field-h: 48px;   /* roomier fields — icons follow automatically */
}
{% endset %}
  {{ snippet(themeExample) }}
</section>
{% endset %}

