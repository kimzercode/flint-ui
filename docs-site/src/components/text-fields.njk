<section class="docs-section">
  <h2 id="i-theming">Theming</h2>
  <p>Everything is a CSS custom property on <code>:root</code> — override inline
     or in your own stylesheet, no rebuild:</p>
  <table class="docs-table">
    <thead>
      <tr><th>Token</th><th>Affects</th></tr>
    </thead>
    <tbody>
      <tr><td><code>--fl-error</code></td><td>Error border, ring and helper text</td></tr>
      <tr><td><code>--fl-border</code></td><td>Outlined border; filled fill is <code>--fl-divider</code></td></tr>
      <tr><td><code>--fl-accent</code></td><td>Focus border/ring and the filled indicator</td></tr>
      <tr><td><code>--fl-disabled</code></td><td>Disabled text color</td></tr>
      <tr><td><code>--fl-radius</code></td><td>Input corner radius (4px)</td></tr>
      <tr><td><code>--fl-fs-caption</code></td><td>Label and helper size (12px)</td></tr>
    </tbody>
  </table>
  {% set themeExample %}
:root {
  --fl-error: #b3261e;      /* deeper error red */
}
{% endset %}
  {{ snippet(themeExample) }}
</section>
{% endset %}

