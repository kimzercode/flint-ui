{#
  Component article: light title + one-liner, centered DESIGN / IMPLEMENTATION
  tab bar (the M2 pattern), per-tab panels, right-hand "Contents" TOC.

  Page frontmatter supplies: title, lead, status, toc {design, impl}
  (each an array of {id, title}). Page content is captured into `design`
  and `impl` and passed via `{% include with %}`.

  Sections must use ids prefixed by tab: d-<id> in the design panel,
  i-<id> in the implementation panel (docs.js keys tab choice off the prefix
  for hash links, and the TOC targets them directly).

  Without JS (html.docs-no-js) both panels render stacked, so the docs
  degrade gracefully — the tabs are an enhancement, not a gate.
#}
<article class="docs-article">
  <header class="docs-art-head">
    <h1>{{ title }}</h1>
    <p class="docs-art-lead">{{ lead }}</p>
  </header>

  <div class="docs-tabbar" role="tablist" aria-label="Component documentation tabs">
    <button type="button" class="docs-tab is-active" id="tab-design" role="tab"
            aria-selected="true" aria-controls="panel-design"
            data-fl-docs-tab="design">
      <svg class="docs-tab__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
      </svg>
      Design
    </button>
    <button type="button" class="docs-tab" id="tab-impl" role="tab"
            aria-selected="false" aria-controls="panel-impl"
            data-fl-docs-tab="impl">
      <svg class="docs-tab__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>
      </svg>
      Implementation
    </button>
  </div>

  <div class="docs-tabbody">
    <div class="docs-panels">
      <section class="docs-panel" id="panel-design" role="tabpanel"
               aria-labelledby="tab-design" data-fl-docs-panel="design">
      {{ design | safe }}
      </section>

      <section class="docs-panel" id="panel-impl" role="tabpanel"
               aria-labelledby="tab-impl" hidden data-fl-docs-panel="impl">
      {{ impl | safe }}
      </section>
    </div>

    <aside class="docs-toc" aria-label="Contents">
      <h2 class="docs-toc__label">Contents</h2>
      <ul class="docs-toc__list" data-fl-docs-toc>
        {% for t in toc.design %}
        <li data-fl-docs-toc-tab="design"><a href="#d-{{ t.id }}">{{ t.title }}</a></li>
        {% endfor %}
        {% for t in toc.impl %}
        <li data-fl-docs-toc-tab="impl"><a href="#i-{{ t.id }}">{{ t.title }}</a></li>
        {% endfor %}
      </ul>
    </aside>
  </div>
</article>
